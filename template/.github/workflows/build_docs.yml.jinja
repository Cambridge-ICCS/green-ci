# Workflow to build and deploy docs for the project
name: Build docs

# Controls when the workflow will run
on:
  # Triggers the workflow on pushes to the "main" branch, i.e., PR merges
  push:
    branches: [ "main" ]
    paths:
      - '.github/workflows/build_docs.yml'{% for trigger in docs_file_paths %}
      - '{{ trigger | safe }}'{% endfor %}

  # Triggers the workflow on pushes to open pull requests to main with documentation changes
  pull_request:
    paths:
      - '.github/workflows/build_docs.yml'{% for trigger in docs_file_paths %}
      - '{{ trigger | safe }}'{% endfor %}

  # Allows you to run this workflow manually from the Actions tab
  workflow_dispatch:

# Helps prevent parallel runs of the workflow from overlapping
concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

# Write permissions are not needed for all jobs in this workflow
permissions: {}

# Workflow run - one or more jobs that can run sequentially or in parallel
jobs:
  # Build the project documentation but do not deploy it
  build:
    name: test docs build
    # The type of runner that the job will run on
    runs-on: ubuntu-latest
    # The timeout minutes for the job to complete
    timeout-minutes: {{ build_docs_timeout }}
    env:
      BUILD_DIR: "TODO replace this string with the path to the build directory"

    # Steps represent a sequence of tasks that will be executed as part of the job
    steps:
      # Checkout your repository under $GITHUB_WORKSPACE so your job can access it
      - name: Checkout code
        with:
          persist-credentials: false
        uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8 # v5.0.0

      {%- if carbon_aware -%}
      {% raw %}
      - name: Start Measurement
        uses: green-coding-solutions/eco-ci-energy-estimation@862050e4f01f65b1436e5eca18ba4bd85562f0de # v5.0.0
        with:
          task: start-measurement
        continue-on-error: true
      {%- endraw -%}
      {% endif %}

      - name: Build documentation
        run: echo "TODO replace this echo call with your docs build commands"

      - name: Upload Artifact
        uses: actions/upload-pages-artifact@7b1f4a764d45c48632c6b24a0339c27f5614fb0b # v4
        with:
          path: {% raw %}${{ env.BUILD_DIR }}{% endraw %}

      {%- if carbon_aware -%}
      {% raw %}
      # NOTE: To measure energy consumption of specific steps in your workflow,
      # For each step you want to measure, add a measurement step after it with a unique label
      # this will allow the eco-ci tool to collect energy consumption data. Example below.
      # See https://github.com/green-coding-solutions/eco-ci-energy-estimation?tab=readme-ov-file#github-action-mandatory-and-optional-variables
      #   - name: Tests measurement
      #     uses: green-coding-solutions/eco-ci-energy-estimation@862050e4f01f65b1436e5eca18ba4bd85562f0de # v5.0.0
      #     with:
      #       task: get-measurement
      #       label: 'pytest'
      #     continue-on-error: true

      - name: Show Energy Results
        uses: green-coding-solutions/eco-ci-energy-estimation@862050e4f01f65b1436e5eca18ba4bd85562f0de # v5.0.0
        with:
          task: display-results
        continue-on-error: true
      {%- endraw -%}
      {% endif %}
{% if deploy_docs %}
  # Build the project documentation and deploy it
  deploy:
    name: deploy to GitHub pages
    # The type of runner that the job will run on
    runs-on: ubuntu-latest
    # The timeout minutes for the job to complete
    timeout-minutes: {{ build_docs_timeout }}
    # This job depends on the one above
    needs: build
    # Only deploy the docs upon merging into main
    if: {% raw %}${{ github.ref == 'refs/heads/main' }}{% endraw %}

    # We trust the deploy action with write permissions
    permissions:
      pages: write  # The deploy action is trusted to write to GitHub Pages
      id-token: write  # The deploy action is trusted to write to GitHub Pages

    # Setup the environment for publishing the docs
    environment:
      name: github-pages
      url: {% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}

    # Steps represent a sequence of tasks that will be executed as part of the job
    steps:
      {%- if carbon_aware -%}
      {% raw %}
      - name: Start Measurement
        uses: green-coding-solutions/eco-ci-energy-estimation@862050e4f01f65b1436e5eca18ba4bd85562f0de # v5.0.0
        with:
          task: start-measurement
        continue-on-error: true
      {%- endraw -%}
      {% endif %}
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e #v4

      {%- if carbon_aware -%}
      {% raw %}
      # NOTE: To measure energy consumption of specific steps in your workflow,
      # For each step you want to measure, add a measurement step after it with a unique label
      # this will allow the eco-ci tool to collect energy consumption data. Example below.
      # See https://github.com/green-coding-solutions/eco-ci-energy-estimation?tab=readme-ov-file#github-action-mandatory-and-optional-variables
      #   - name: Tests measurement
      #     uses: green-coding-solutions/eco-ci-energy-estimation@862050e4f01f65b1436e5eca18ba4bd85562f0de # v5.0.0
      #     with:
      #       task: get-measurement
      #       label: 'pytest'
      #     continue-on-error: true

      - name: Show Energy Results
        uses: green-coding-solutions/eco-ci-energy-estimation@862050e4f01f65b1436e5eca18ba4bd85562f0de # v5.0.0
        with:
          task: display-results
        continue-on-error: true
      {%- endraw -%}
      {%- endif -%}
{%- endif -%}
